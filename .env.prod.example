x# Production environment template.
#
# Usage:
#   cp .env.prod.example .env.prod
#   <fill in APP_KEY and secrets>
#   docker compose --env-file .env.prod -f docker-compose.prod.yml pull
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d
#
# .env.prod is gitignored — never commit real secrets.

# ============================================================================
# Image registry
# ============================================================================
# GitHub Container Registry by default. Override REGISTRY/IMAGE_NAMESPACE to
# push or pull from a different registry or org.
REGISTRY=ghcr.io
IMAGE_NAMESPACE=TrachukBohdan
IMAGE_TAG=latest

# ============================================================================
# Web entry point (the only port exposed to the host)
# ============================================================================
WEB_PORT=80

# ============================================================================
# Laravel
# ============================================================================
APP_NAME=BankaAi

# Generate ONCE and paste below. From inside this repo:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml \
#     run --rm --no-deps api php artisan key:generate --show
APP_KEY=

APP_URL=https://example.com
LOG_LEVEL=warning

# Used by the SPA build (baked into the bundle). `/api` is the same-origin
# default that matches the nginx reverse proxy in docker/web/default.conf.
VITE_API_URL=/api

# ============================================================================
# Database (must match values you want MySQL to be initialised with)
# ============================================================================
DB_DATABASE=bankaai
DB_USERNAME=bankaai
DB_PASSWORD=change-me-strong-password
DB_ROOT_PASSWORD=change-me-strong-root-password
