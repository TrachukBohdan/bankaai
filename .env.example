# Override these by copying to .env at the repo root and editing as needed.
# docker-compose.yml reads them via ${VAR:-default} interpolation.

# Public entry point (nginx)
WEB_PORT=8080

# Vite dev server is also exposed directly on the host so the HMR WebSocket
# can bypass nginx (avoids RSV1/permessage-deflate quirks through the proxy).
UI_HMR_PORT=5173

# MySQL is exposed on the host for debugging (mysql workbench / TablePlus / cli).
DB_PORT=3306

# MySQL credentials (shared by the db service and Laravel)
DB_DATABASE=bankaai
DB_USERNAME=bankaai
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root
